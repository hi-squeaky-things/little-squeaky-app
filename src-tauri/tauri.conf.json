{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "little-squeaky",
  "version": "0.2.0",
  "identifier": "nl.hisqueakythings.little-squeakyp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "little squeaky",
        "minWidth": 1024,
        "minHeight": 800,
        "width": 1024,
        "height": 800,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
